# Caddyfile для Mini App: статика зібраного React + проксі /api у FastAPI.
#
# За замовчуванням слухає порт 80 (HTTP). Якщо задано змінну оточення APP_DOMAIN
# (наприклад, APP_DOMAIN=app.example.com), Caddy автоматично отримає та оновить
# TLS-сертифікат від Let's Encrypt / ZeroSSL.

{$APP_DOMAIN::80} {
	root * /srv
	encode gzip zstd

	# Захисні заголовки
	# УВАГА: Telegram відкриває Mini App у WebView, а на Desktop — в iframe.
	# Дозволяємо відображення у фреймах лише всередині Telegram для захисту від клікджекінгу (SEC-10).
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org;"
	}

	# Обмеження розміру запитів (аналог client_max_body_size 2m)
	request_body {
		max_size 2MB
	}

	# Проксі API у контейнер FastAPI
	@api path /api /api/*
	handle @api {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {remote_host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	# Статика та SPA
	handle {
		# Кешування для асетів Vite (хешовані імена на кшталт app.a1b2c3d4.js — незмінні)
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# index.html не кешуємо: інакше після деплою користувач тягне старі ассети
		@index path /index.html
		header @index Cache-Control "no-cache, no-store, must-revalidate"

		# SPA-fallback: усі невідомі шляхи віддаємо роутеру на клієнті
		try_files {path} /index.html
		file_server
	}
}

