# ==============================================================================
# Шаблон конфігурації для PRODUCTION-середовища (doma_app).
# Скопіюйте у .env на продакшн-сервері:
#     cp .env.prod.example .env
# Заповніть ваші реальні секрети та домен.
# ==============================================================================

# --- Домен та SSL (Caddy) ---
# Публічний домен вашого застосунку. Caddy автоматично отримає Let's Encrypt SSL-сертифікат.
APP_DOMAIN=doma.example.com

# --- База даних PostgreSQL (Docker-контейнер) ---
POSTGRES_DB=doma_app_db
POSTGRES_USER=doma_user
POSTGRES_PASSWORD=generate_a_very_strong_password_here

# DSN підключення для API, бота та migrator (використовує внутрішній хост postgres)
DATABASE_URL=postgresql://doma_user:generate_a_very_strong_password_here@postgres:5432/doma_app_db

# --- Telegram Bot ---
# Офіційний токен бота від @BotFather
BOT_TOKEN=123456789:AA-your-production-bot-token
# Юзернейм вашого Telegram бота (без @)
BOT_USERNAME=doma_pizza_bot
# Повна URL-адреса Mini App (має збігатися з APP_DOMAIN)
MINI_APP_URL=https://doma.example.com
# Telegram ID чату/групи менеджерів для модерації та сповіщень (наприклад: -1001234567890)
MANAGER_CHAT_ID=-1001234567890

# --- FastAPI Backend ---
# На проді ОБОВ'ЯЗКОВО false!
API_DEBUG=false
# Дозволені джерела CORS (ваш прод-домен)
CORS_ORIGINS=https://doma.example.com
# Директорія збереження завантажених фотографій
UPLOADS_DIR=/directus/uploads

# --- Redis, кешування та Rate Limiting (PERF-3) ---
REDIS_URL=redis://redis:6379/0
CATALOG_CACHE_ENABLED=true
CATALOG_CACHE_TTL=1800
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend (Vite) ---
VITE_PUBLIC_HOST=doma.example.com
VITE_API_BASE_URL=/api
# На проді має бути порожнім!
VITE_DEV_INIT_DATA=

# --- Directus CMS (Опціонально, профіль cms) ---
DIRECTUS_PORT=8055
DIRECTUS_KEY=generate-random-uuid-here
DIRECTUS_SECRET=generate-random-secret-here
DIRECTUS_ADMIN_EMAIL=admin@doma.local
DIRECTUS_ADMIN_PASSWORD=generate-strong-admin-password
DIRECTUS_PUBLIC_URL=https://doma.example.com/directus

