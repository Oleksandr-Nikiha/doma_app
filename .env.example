# Шаблон конфігурації. Скопіюй у .env і підстав реальні значення:
#     cp .env.example .env
# Сам .env у git не потрапляє (див. .gitignore).

# --- Postgres ---
DATABASE_URL=postgresql://user:password@host:5432/doma_app_db

# --- Telegram Bot ---
BOT_TOKEN=123456789:AA-your-bot-token-from-BotFather
# URL, який BotFather віддає для Menu Button (web_app). Локально — тунель або staging-домен.
MINI_APP_URL=https://your-tunnel.ngrok-free.app

# --- API ---
# Використовується api/src/auth для валідації Telegram.WebApp.initData (HMAC перевіряється тим же BOT_TOKEN)
API_DEBUG=true
# Origins, яким дозволено ходити в API з браузера — через кому, без пробілів
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite читає змінні з префіксом VITE_) ---
VITE_API_BASE_URL=http://localhost:8010/api
