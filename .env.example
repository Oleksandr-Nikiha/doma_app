# Шаблон конфігурації. Скопіюй у .env і підстав реальні значення:
#     cp .env.example .env
# Сам .env у git не потрапляє (див. .gitignore).

# --- Postgres ---
DATABASE_URL=postgresql://user:password@host:5432/doma_app_db

# --- Telegram Bot ---
BOT_TOKEN=123456789:AA-your-bot-token-from-BotFather
# URL, який BotFather віддає для Menu Button (web_app). Локально — тунель або staging-домен.
MINI_APP_URL=https://your-domain.example.com

# --- API ---
# Використовується api/src/auth для валідації Telegram.WebApp.initData (HMAC перевіряється тим же BOT_TOKEN)
API_DEBUG=true
# Origins, яким дозволено ходити в API з браузера — через кому, без пробілів
CORS_ORIGINS=https://your-domain.example.com,http://localhost:5173

# --- Frontend (Vite читає змінні з префіксом VITE_) ---
# Домен, з якого Telegram відкриває Mini App. Потрібен Vite для allowedHosts і HMR.
VITE_PUBLIC_HOST=your-domain.example.com
# Шлях відносний: і локально (проксі Vite), і в проді (nginx) API живе на /api
VITE_API_BASE_URL=/api
# Підписаний initData для розробки у браузері (поза Telegram initData порожній).
# Згенерувати: python3 scripts/generate_test_init_data.py "$BOT_TOKEN"
# Діє 24 години — після протухання перегенерувати.
VITE_DEV_INIT_DATA=
